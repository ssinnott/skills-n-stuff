{
  "name": "obsidian-wf",
  "version": "0.1.0",
  "description": "Obsidian plugin fronting the wf agent work queue",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --platform=node --outfile=main.js && cp src/styles.css styles.css",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@types/node": "^26.2.0"
  }
}
