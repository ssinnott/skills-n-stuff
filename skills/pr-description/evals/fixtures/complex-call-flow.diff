@@ -0,0 +1,42 @@
+import { submitOrderHandler } from "../src/routes/orders";
+import { idempotencyStore } from "../src/db/idempotency";
+
+describe("order idempotency", () => {
+  it("replays the original receipt for a repeated key", async () => {
+    const first = await post("/orders", order, { "Idempotency-Key": "k1" });
+    const second = await post("/orders", order, { "Idempotency-Key": "k1" });
+    expect(second.body).toEqual(first.body);
+    expect(second.headers["idempotent-replayed"]).toBe("true");
+    expect(chargeSpy).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects submissions without a key", async () => {
+    const res = await post("/orders", order, {});
+    expect(res.status).toBe(400);
+  });
+
+  it("ships an order only once across queue redeliveries", async () => {
+    await enqueueTwice("order-1", "k2");
+    await drainQueue();
+    expect(shipSpy).toHaveBeenCalledTimes(1);
+  });
+});
