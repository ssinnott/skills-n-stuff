@@ -1,14 +1,21 @@
 import { Worker } from "bullmq";
+import { idempotencyStore } from "../db/idempotency";
 import { shipOrder } from "./shipping";

 export const fulfillmentWorker = new Worker("fulfillment", async (job) => {
-  const { orderId } = job.data;
+  const { orderId, idempotencyKey } = job.data;
+
+  // Queue retries redeliver jobs; only the first delivery for a key ships.
+  const firstDelivery = await idempotencyStore.claim(`fulfill:${idempotencyKey}`);
+  if (!firstDelivery) {
+    return;
+  }

   await shipOrder(orderId);
 });
