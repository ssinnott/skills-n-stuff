diff --git a/src/db/idempotency.ts b/src/db/idempotency.ts
new file mode 100644
index 0000000..8e9f0a1
--- /dev/null
+++ b/src/db/idempotency.ts
@@ -0,0 +1,34 @@
+import { redis } from "./redis";
+
+const TTL_SECONDS = 24 * 60 * 60;
+
+// Stores the response we produced for a given Idempotency-Key so a retried
+// submission returns the original receipt instead of re-processing.
+export const idempotencyStore = {
+  async get(key: string): Promise<unknown | null> {
+    const raw = await redis.get(`idem:${key}`);
+    return raw ? JSON.parse(raw) : null;
+  },
+
+  async put(key: string, value: unknown): Promise<void> {
+    await redis.set(`idem:${key}`, JSON.stringify(value), {
+      EX: TTL_SECONDS,
+      NX: true,
+    });
+  },
+
+  async claim(key: string): Promise<boolean> {
+    const claimed = await redis.set(`idem:claim:${key}`, "1", {
+      EX: TTL_SECONDS,
+      NX: true,
+    });
+    return claimed === "OK";
+  },
+};
