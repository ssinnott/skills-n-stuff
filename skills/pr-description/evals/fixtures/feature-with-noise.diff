diff --git a/src/api/client.js b/src/api/client.js
index 9d8e7f6..2b3c4d5 100644
--- a/src/api/client.js
+++ b/src/api/client.js
@@ -1,24 +1,63 @@
 const { request } = require("undici");
 const logger = require("../logger");

+const RETRYABLE_STATUS = new Set([429, 502, 503, 504]);
+const MAX_RETRIES = 3;
+const BASE_DELAY_MS = 250;
+
+function sleep(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function backoffDelay(attempt) {
+  const exp = BASE_DELAY_MS * 2 ** attempt;
+  const jitter = Math.random() * exp * 0.2;
+  return exp + jitter;
+}
+
 class ApiClient {
   constructor(baseUrl, opts = {}) {
     this.baseUrl = baseUrl;
     this.timeout = opts.timeout ?? 30_000;
+    this.maxRetries = opts.maxRetries ?? MAX_RETRIES;
   }

   async get(path) {
-    const res = await request(`${this.baseUrl}${path}`, {
-      method: "GET",
-      headersTimeout: this.timeout,
-    });
-    if (res.statusCode >= 400) {
-      throw new Error(`GET ${path} failed: ${res.statusCode}`);
-    }
-    return res.body.json();
+    return this.#withRetries("GET", path, () =>
+      request(`${this.baseUrl}${path}`, {
+        method: "GET",
+        headersTimeout: this.timeout,
+      })
+    );
   }

   async post(path, body) {
-    const res = await request(`${this.baseUrl}${path}`, {
-      method: "POST",
-      headersTimeout: this.timeout,
-      headers: { "content-type": "application/json" },
-      body: JSON.stringify(body),
-    });
-    if (res.statusCode >= 400) {
-      throw new Error(`POST ${path} failed: ${res.statusCode}`);
-    }
-    return res.body.json();
+    return this.#withRetries("POST", path, () =>
+      request(`${this.baseUrl}${path}`, {
+        method: "POST",
+        headersTimeout: this.timeout,
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify(body),
+      })
+    );
+  }
+
+  async #withRetries(method, path, doRequest) {
+    let lastError;
+    for (let attempt = 0; attempt <= this.maxRetries; attempt++) {
+      try {
+        const res = await doRequest();
+        if (RETRYABLE_STATUS.has(res.statusCode) && attempt < this.maxRetries) {
+          const delay = backoffDelay(attempt);
+          logger.warn(
+            { method, path, status: res.statusCode, attempt, delay },
+            "retrying request"
+          );
+          await sleep(delay);
+          continue;
+        }
+        if (res.statusCode >= 400) {
+          throw new Error(`${method} ${path} failed: ${res.statusCode}`);
+        }
+        return res.body.json();
+      } catch (err) {
+        lastError = err;
+        if (err.code !== "ECONNRESET" || attempt >= this.maxRetries) throw err;
+        await sleep(backoffDelay(attempt));
+      }
+    }
+    throw lastError;
   }
 }

diff --git a/test/api/client.test.js b/test/api/client.test.js
index 5e6f7a8..b9c0d1e 100644
--- a/test/api/client.test.js
+++ b/test/api/client.test.js
@@ -30,4 +30,38 @@ describe("ApiClient", () => {
     await assert.rejects(client.get("/missing"), /404/);
   });
+
+  it("retries on 503 and succeeds", async () => {
+    let calls = 0;
+    server.on("request", (req, res) => {
+      calls++;
+      if (calls < 3) {
+        res.statusCode = 503;
+        res.end();
+      } else {
+        res.end(JSON.stringify({ ok: true }));
+      }
+    });
+    const result = await client.get("/flaky");
+    assert.equal(calls, 3);
+    assert.deepEqual(result, { ok: true });
+  });
+
+  it("gives up after maxRetries and throws", async () => {
+    server.on("request", (req, res) => {
+      res.statusCode = 503;
+      res.end();
+    });
+    const client = new ApiClient(baseUrl, { maxRetries: 1 });
+    await assert.rejects(client.get("/down"), /503/);
+  });
+
+  it("does not retry on 400", async () => {
+    let calls = 0;
+    server.on("request", (req, res) => {
+      calls++;
+      res.statusCode = 400;
+      res.end();
+    });
+    await assert.rejects(client.get("/bad"), /400/);
+    assert.equal(calls, 1);
+  });
 });
