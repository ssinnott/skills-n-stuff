{
  "name": "obsidian-pi-tasks",
  "version": "0.1.0",
  "description": "Obsidian plugin binding pi coding-agent sessions to documents",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --platform=node --outfile=main.js",
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/docbind.ts --bundle --format=esm --platform=node --outfile=test/docbind.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@types/node": "^26.2.0"
  }
}
